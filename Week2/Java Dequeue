import java.util.*;
public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int m = sc.nextInt();
        Deque<Integer> deque = new ArrayDeque<>();
        Set<Integer> set = new HashSet<>();
        int[] arr = new int[n];
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }
        int max = 0;
        for (int i = 0; i < n; i++) {
            deque.addLast(arr[i]);
            if (deque.size() > m) {
                deque.removeFirst();
            }
            if (deque.size() == m) {
                set.clear();
                set.addAll(deque);
                max = Math.max(max, set.size());
            }
        }
        System.out.println(max);
        sc.close();
    }
}
Input:
6 3
5 3 5 2 3 2
Output:
3
