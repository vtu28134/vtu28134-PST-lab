class Solution {
    public int removeDuplicates(int[] nums) {
        int[] unique = Arrays.stream(nums)
                .filter((value) -> true)
                .distinct()
                .toArray();
        for (int i = 0; i < unique.length; i++) {
            nums[i] = unique[i];
        }
        return unique.length;
    }
}
