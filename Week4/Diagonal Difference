import java.util.*;
public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[][] a = new int[n][n];
        int d1 = 0, d2 = 0;
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                a[i][j] = sc.nextInt();
                if (i == j) d1 += a[i][j];
                if (i + j == n - 1) d2 += a[i][j];
            }
        }
        System.out.println(Math.abs(d1 - d2));
        sc.close();
    }
}
Input:
3
11 2 4
4 5 6
10 8 -12
Output:
15
