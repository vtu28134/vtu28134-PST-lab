import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();
            int[] a = new int[n];

            for (int i = 0; i < n; i++)
                a[i] = sc.nextInt();

            int current = a[0];
            int best = a[0];
            int sum = 0, largest = a[0];

            for (int i = 0; i < n; i++) {
                current = Math.max(a[i], current + a[i]);
                best = Math.max(best, current);
                largest = Math.max(largest, a[i]);

                if (a[i] > 0)
                    sum += a[i];
            }

            if (sum == 0)
                sum = largest;

            System.out.println(best + " " + sum);
        }
    }
}
Input:
2
4
1 2 3 4
6
2 -1 2 3 4 -5
Output:
10 10
10 11
